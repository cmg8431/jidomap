{
  "name": "@jidomap/pipeline",
  "version": "0.0.1",
  "private": true,
  "description": "OSM Overpass → @jidomap/data GeoJSON 재생성 파이프라인. CI cron 이 매월 실행한다",
  "type": "module",
  "scripts": {
    "generate": "bun run src/index.ts",
    "generate:subway": "bun run src/index.ts subway",
    "generate:boundaries": "bun run src/index.ts boundaries",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo",
    "generate:underground": "bun run src/underground.ts"
  },
  "dependencies": {
    "osmtogeojson": "3.0.0-beta.5",
    "proj4": "^2.15.0",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "@jidomap/typescript": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/geojson": "^7946.0.14",
    "typescript": "catalog:",
    "@types/proj4": "^2.5.5"
  }
}
